# AULA backend configuration
# Copy to .env and fill in as needed. Keys can also be set entirely from the
# UI (Connections screen) at runtime — nothing here is required to boot.

# CORS: comma-separated origins allowed to call the API. The frontend is served
# by the backend itself (http://localhost:8000), so this only matters if you
# host the static files elsewhere.
AULA_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173

# Go live straight from .env — EITHER drop in a standard vendor key:
# ANTHROPIC_API_KEY=sk-ant-...     -> Claude
# OPENAI_API_KEY=sk-...            -> GPT
# GEMINI_API_KEY=...               -> Gemini
# MISTRAL_API_KEY=...              -> Mistral
# GROQ_API_KEY=...                 -> Groq
#
# OR set the explicit AULA_* form (wins over vendor keys):
# Provider is one of: claude | openai | groq | gemini | mistral | ollama
# AULA_PROVIDER=claude
# AULA_API_KEY=sk-ant-...
# AULA_MODEL=claude-opus-4-8
# Ollama runs locally and needs no key; override its endpoint if not default:
# AULA_OLLAMA_BASE_URL=http://localhost:11434/v1
#
# A connector saved from the UI (backend/.connectors.json) overrides .env.

# Credits: the default budget cap is $5.00 of estimated LLM spend. Change it in
# the Connections screen (Credits & budget) — it persists in backend/aula.db.
